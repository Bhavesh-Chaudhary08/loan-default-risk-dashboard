{
    // Loan Default Risk Memorandum — VS Code tasks
    // Ctrl+Shift+B (or Terminal > Run Task) starts the server and opens the app.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Dashboard (server only)",
            "type": "shell",
            "command": "python",
            "args": ["app.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "detail": "Flask app on http://localhost:5000 (keep running)"
        },
        {
            "label": "Start Dashboard & Open Browser",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$ok=$false; foreach($i in 1..40){ try { $r=Invoke-WebRequest -UseBasicParsing -TimeoutSec 2 -Uri 'http://127.0.0.1:5000/health'; if($r.StatusCode -eq 200){ $ok=$true; break } } catch {}; Start-Sleep -Milliseconds 500 }; if($ok){ Start-Process 'http://localhost:5000/' } else { Write-Host 'Server did not respond within 20s - check the Run Dashboard terminal for the actual error.' }"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Run Dashboard (server only)"],
            "problemMatcher": [],
            "presentation": { "reveal": "never", "panel": "shared" },
            "group": { "kind": "build", "isDefault": true },
            "detail": "One-click: starts the server, waits until it answers /health, then opens the app in your browser"
        }
    ]
}
